{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/user_prompt_submit_router.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)\\.codex\\hooks\\user_prompt_submit_router.py\"",
            "statusMessage": "Classifying KRT task complexity"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^spark_implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent_start_context.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)\\.codex\\hooks\\subagent_start_context.py\"",
            "statusMessage": "Reinforcing Spark role"
          }
        ]
      },
      {
        "matcher": "^code-mapper$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent_start_context.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)\\.codex\\hooks\\subagent_start_context.py\"",
            "statusMessage": "Reinforcing code-mapper role"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_workflow_enforcer.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)\\.codex\\hooks\\stop_workflow_enforcer.py\"",
            "timeout": 30,
            "statusMessage": "Checking 55to53 workflow completion"
          }
        ]
      }
    ]
  }
}
